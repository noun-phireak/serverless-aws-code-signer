{
  "name": "serverless-aws-code-signer",
  "version": "1.0.3",
  "description": "Sign Lambda deployment artifacts with AWS Signer. Fails closed, never creates signing profiles or buckets, and verifies the signed artifact on disk before CloudFormation hashes it.",
  "keywords": [
    "serverless",
    "serverless-plugin",
    "aws",
    "aws-signer",
    "lambda",
    "code-signing",
    "supply-chain"
  ],
  "license": "MIT",
  "author": "noun-phireak <phireaknoun@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noun-phireak/serverless-aws-code-signer.git"
  },
  "bugs": {
    "url": "https://github.com/noun-phireak/serverless-aws-code-signer/issues"
  },
  "homepage": "https://github.com/noun-phireak/serverless-aws-code-signer#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-signer": "^3.700.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "aws-sdk-client-mock": "^4.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
